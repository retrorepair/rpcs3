# Repository line-ending policy.
#
# Default: text files are stored as LF in the repo AND checked out as LF
# in the working tree on every platform. This matches what upstream RPCS3
# already commits (HEAD is LF on all source) and stops the ~1625-file
# "phantom modifications" flood that Windows checkout otherwise produces
# when no policy is set.
#
# `text=auto` lets Git auto-detect text vs binary for unlisted patterns.
# `eol=lf` overrides any local `core.autocrlf` so the rule wins regardless
# of per-machine git config.

* text=auto eol=lf

# Windows-only tooling files that genuinely need CRLF (the Windows
# toolchain expects it; MSBuild and cmd refuse some LF-only content).
*.bat              text eol=crlf
*.cmd              text eol=crlf
*.ps1              text eol=crlf
*.sln              text eol=crlf
*.vcxproj          text eol=crlf
*.vcxproj.filters  text eol=crlf
*.vcxproj.user     text eol=crlf
*.props            text eol=crlf

# Explicit binaries: never normalize, never diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.bmp   binary
*.webp  binary
*.svg   text
*.bin   binary
*.dat   binary
*.spv   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.rar   binary
*.dll   binary
*.lib   binary
*.exe   binary
*.so    binary
*.a     binary
*.o     binary
*.obj   binary
*.pdb   binary
*.pdf   binary
*.ogg   binary
*.wav   binary
*.mp3   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.rbf   binary

# Linguist hints for the GitHub language-stats sidebar (cosmetic; keeps
# the repo from being categorized as C/C++ "vendored" code).
3rdparty/**     linguist-vendored
